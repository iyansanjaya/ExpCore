{
  "name": "expcore",
  "productName": "ExpCore",
  "version": "3.0.0",
  "description": "Toolkit PDF Coretax",
  "author": "Iyan Sanjaya",
  "license": "Apache-2.0",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "build:renderer": "tailwindcss -i app/renderer/src/styles.css -o app/renderer/dist/styles.css --minify && esbuild app/renderer/src/app.js --bundle --format=iife --target=chrome130 --minify --legal-comments=none --loader:.woff2=file --loader:.woff=file --asset-names=fonts/[name]-[hash] --entry-names=app --outdir=app/renderer/dist",
    "start": "npm run build:renderer && electron .",
    "pretest": "npm run build:renderer",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 tests/*.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "motion": "13.4.3",
    "playwright-core": "1.63.0",
    "reicon": "1.2.4",
    "tailwindcss": "4.3.3"
  },
  "build": {
    "appId": "iyansanjaya.expcore.1.0",
    "productName": "ExpCore",
    "copyright": "Copyright © 2026 Iyan Sanjaya",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "!app/renderer/src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "expcore_engine.dist",
        "to": "engine"
      }
    ],
    "electronLanguages": [
      "en-US",
      "id"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "ExpCore"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExpCore",
      "artifactName": "ExpCore-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iyansanjaya",
        "repo": "ExpCore"
      }
    ]
  }
}
